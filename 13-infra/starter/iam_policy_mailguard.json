{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SecureDropObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::YOUR_SECURE_DROP_BUCKET/*"
    },
    {
      "Sid": "SecureDropListBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::YOUR_SECURE_DROP_BUCKET"
    },
    {
      "Sid": "HoldQueueConsume",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes",
        "sqs:ChangeMessageVisibility"
      ],
      "Resource": "arn:aws:sqs:REGION:ACCOUNT_ID:mailguard-hold-dev"
    }
  ]
}
